import unittest
import cv2
import numpy as np

class TestFaceRecognition(unittest.TestCase):
    def test_face_detection(self):
        # Arrange
        face_detector = cv2.CascadeClassifier(cv2.data.haarcascades + "haarcascade_frontalface_default.xml")
        cap = cv2.VideoCapture(0)
        ret, frame = cap.read()
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        
        # Act
        faces = face_detector.detectMultiScale(gray, scaleFactor=1.1, minNeighbors=5)
        
        # Assert
        self.assertIsNotNone(faces)
        cap.release()
        cv2.destroyAllWindows()

    def test_face_recognition(self):
        # Arrange
        face_recognizer = cv2.face.LBPHFaceRecognizer_create()
        face_detector = cv2.CascadeClassifier(cv2.data.haarcascades + "haarcascade_frontalface_default.xml")
        cap = cv2.VideoCapture(0)
        ret, frame = cap.read()
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        faces = face_detector.detectMultiScale(gray, scaleFactor=1.1, minNeighbors=5)
        face_roi = gray[faces[0][1]:faces[0][1]+faces[0][3], faces[0][0]:faces[0][0]+faces[0][2]]
        face_features = cv2.resize(face_roi, (512, 512), interpolation=cv2.INTER_AREA)
        
        # Act
        label, confidence = face_recognizer.predict(face_features)
        
        # Assert
        self.assertIsNotNone(label)
        self.assertIsNotNone(confidence)
        cap.release()
        cv2.destroyAllWindows()

    def test_face_save(self):
        # Arrange
        face_detector = cv2.CascadeClassifier(cv2.data.haarcades + "haarcascade_frontalface_default.xml")
        cap = cv2.VideoCapture(0)
        ret, frame = cap.read()
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        faces = face_detector.detectMultiScale(gray, scaleFactor=1.1, minNeighbors=5)
        face_roi = gray[faces[0][1]:faces[0][1]+faces[0][3], faces[0][0]:faces[0][0]+faces[0][2]]
        
        # Act
        cv2.imwrite('face.jpg', face_roi)
        
        # Assert
        self.assertTrue(cv2.imread('face.jpg') is not None)
        cap.release()
        cv2.destroyAllWindows()

if __name__ == '__main__':
    unittest.main()